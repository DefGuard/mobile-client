{
	"name": "e2e-mobile",
	"private": true,
	"type": "module",
	"scripts": {
		"build:ios": "cd ../client && flutter build ios --simulator",
		"build:android": "cd ../client && flutter build apk --debug",
		"test:ios": "wdio run ./wdio.ios.conf.ts",
		"test:android": "wdio run ./wdio.android.conf.ts",
		"appium:driver:ios": "APPIUM_HOME=$HOME/.appium appium driver list --installed --json | grep -q xcuitest || APPIUM_HOME=$HOME/.appium appium driver install xcuitest",
		"appium:driver:android": "APPIUM_HOME=$HOME/.appium appium driver list --installed --json | grep -q uiautomator2 || APPIUM_HOME=$HOME/.appium appium driver install uiautomator2",
		"appium:doctor:ios": "APPIUM_HOME=$HOME/.appium appium driver doctor xcuitest",
		"appium:doctor:android": "APPIUM_HOME=$HOME/.appium appium driver doctor uiautomator2",
		"fix": "biome check --fix",
		"lint": "biome check",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@types/node": "25.9.5",
		"@wdio/appium-service": "9.31.5",
		"@wdio/cli": "9.31.5",
		"@wdio/globals": "9.31.3",
		"@wdio/local-runner": "9.31.5",
		"@wdio/mocha-framework": "9.31.5",
		"@wdio/spec-reporter": "9.31.2",
		"@wdio/types": "9.31.2",
		"appium": "3.7.0",
		"otpauth": "9.5.2",
		"tsx": "4.23.13",
		"typescript": "5.9.3"
	}
}
