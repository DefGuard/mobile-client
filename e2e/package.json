{
	"name": "e2e-mobile",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"build:ios": "cd ../client && flutter build ipa --export-method development --dart-define=E2E=true",
		"test:ios": "wdio run ./wdio.ios.conf.ts",
		"appium:setup": "APPIUM_HOME=$HOME/.appium appium driver install xcuitest",
		"appium:doctor": "APPIUM_HOME=$HOME/.appium appium driver doctor xcuitest"
	},
	"devDependencies": {
		"@types/node": "^25.9.2",
		"@wdio/appium-service": "^9.31.0",
		"@wdio/cli": "^9.31.0",
		"@wdio/globals": "^9.31.0",
		"@wdio/local-runner": "^9.31.0",
		"@wdio/mocha-framework": "^9.31.0",
		"@wdio/spec-reporter": "^9.31.0",
		"@wdio/types": "^9.31.0",
		"appium": "^3.7.0",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3"
	}
}
